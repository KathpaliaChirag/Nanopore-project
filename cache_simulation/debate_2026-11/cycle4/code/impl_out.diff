+static inline void AppendU64(std::string &o, uint64_t v) {
+  // hand itoa (to_chars needs c++17, the build is c++11)
+  char buf[24];
+  char *p = buf + sizeof(buf);
+  do { *--p = (char) ('0' + (v % 10)); v /= 10; } while (v);
+  o.append(p, buf + sizeof(buf) - p);
+}
+
+void AddHitlistStringFast(std::string &o, vector<taxid_t> &taxa,
+    Taxonomy &taxonomy)
+{
+  auto last_code = taxa[0];
+  uint64_t code_count = 1;
+  auto emit = [&](taxid_t lc, uint64_t cc, bool trailing_space) {
+    if (lc != MATE_PAIR_BORDER_TAXON && lc != READING_FRAME_BORDER_TAXON) {
+      if (lc == AMBIGUOUS_SPAN_TAXON) {
+        o.append("A:", 2);
+        AppendU64(o, cc);
+        o.push_back(' ');   // old code keeps the trailing space for A: even on the last run
+      }
+      else {
+        AppendU64(o, (uint64_t) taxonomy.nodes()[lc].external_id);
+        o.push_back(':');
+        AppendU64(o, cc);
+        if (trailing_space) o.push_back(' ');
+      }
+    }
+    else {
+      o.append(lc == MATE_PAIR_BORDER_TAXON ? "|:|" : "-:-", 3);
+      if (trailing_space) o.push_back(' ');
+    }
+  };
+  for (size_t i = 1; i < taxa.size(); i++) {
+    auto code = taxa[i];
+    if (code == last_code) {
+      code_count += 1;
+    }
+    else {
+      emit(last_code, code_count, true);
+      code_count = 1;
+      last_code = code;
+    }
+  }
+  emit(last_code, code_count, false);
+}
