+              fmt = s.format = SequenceFormat::FORMAT_FASTQ;
+              if (ks->qual.l > 0 && ! skipq) s.quals.assign(ks->qual.s, ks->qual.l); else s.quals.clear();
+            } else {
+              fmt = s.format = SequenceFormat::FORMAT_FASTA;
+            }
+          }
+          else if (rc == -1 || ! last_file) break;
+        }
+        kseq_destroy(ks);
+        ::close(mfd);
+      }
