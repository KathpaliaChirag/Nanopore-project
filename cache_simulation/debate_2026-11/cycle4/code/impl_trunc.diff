+      // stock (LoadBlock): any kseq_read < 0 moves to the next file if there is one (rest of this file dropped), and in the
+      // last file a -2 just ends the block and the next LoadBlock resumes the stream (resync at the next '@' or '>').
+      void tail(const char *p, size_t len) {
+        int mfd = memfd_create("k2tail", 0);
+        if (mfd < 0) { tail_failed = true; return; }
+        size_t off = 0;
+        while (off < len) {
+          ssize_t w = ::write(mfd, p + off, len - off);
+          if (w <= 0) { tail_failed = true; ::close(mfd); return; }
+          off += (size_t) w;
+        }
+        lseek(mfd, 0, SEEK_SET);
+        kseq_t *ks = kseq_init(mfd);   // copies k2_skip_qual() into ks->skip_qual, same as the stock reader
+        for (;;) {
+          int rc = kseq_read(ks);
