+      // pre-pass over every chunk, before any output file exists: damage anywhere except a file tail (handled exactly by the kseq
+      // replay in LoadPreadTry) makes the whole run use the stock kseq path, so malformed input behaves exactly like stock.
+      // K2_PREAD_PRESCAN=0 skips this (damage found later then aborts with exit 3, as before).
+      const char *pe = getenv("K2_PREAD_PRESCAN");
+      if (use_pread && (pe == nullptr || strcmp(pe, "0") != 0)) {
+        int prescan_bad = 0;
+        #pragma omp parallel
+        {
+          std::vector<char> pbuf;
+          k2pread::NullSink null_sink;
+          #pragma omp for schedule(dynamic, 1)
+          for (int64_t pt = 0; pt < (int64_t) pread_plan.total; pt++) {
+            if (__atomic_load_n(&prescan_bad, __ATOMIC_RELAXED)) continue;
+            size_t pf; uint64_t pk; std::string perr;
+            pread_plan.Locate((uint64_t) pt, pf, pk);
+            if (k2pread::read_chunk(pread_plan.fds[pf], pread_plan.sizes[pf], pk, pread_plan.B, pbuf, null_sink, &perr) != k2pread::PR_OK) {
+              __atomic_store_n(&prescan_bad, 1, __ATOMIC_RELAXED);
+              if (getenv("K2_PREAD_VERBOSE")) fprintf(stderr, "K2_PREAD: prescan found damage in chunk %lld: %s\n", (long long) pt, perr.c_str());
+            }
+          }
+        }
+        if (prescan_bad) { use_pread = false; why = "prescan found damage"; }
+      }
       if (getenv("K2_PREAD_VERBOSE"))
         fprintf(stderr, "K2_PREAD: %s (%s), %llu chunks of %llu bytes\n", use_pread ? "on" : "off, using kseq path",
                 use_pread ? "ok" : why.c_str(), (unsigned long long) pread_plan.total, (unsigned long long) chunk);
