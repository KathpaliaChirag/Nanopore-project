+  // Option 4 fast path: parse one strict 4-line FASTQ record straight out of
+  // kseq's stream buffer into the Sequence strings (one copy instead of two).
+  // Returns false, without consuming anything, whenever the record is not
+  // strictly 4 lines or is not fully buffered even after refilling; the caller
+  // then runs the real kseq_read + copy_from_kseq on the untouched stream.
+  // Rules mirror kseq_read exactly (see round2_A_reader_design.md section 5).
+  bool FastRecord(Sequence& seq, size_t& slen)
+  {
+    if (kseq_->last_char != 0) return false;
+    kstream_t* ks = kseq_->f;
+    for (;;) {
+      int st = 1;  // 0 ok, 1 incomplete, 2 not strict
+      if (ks->begin < ks->end) {
+        const unsigned char* b = ks->buf;
+        const unsigned char* p = b + ks->begin;
+        const unsigned char* e = b + ks->end;
+        if (*p != '@') return false;
+        st = 1;
+        const unsigned char* n1 = (const unsigned char*)memchr(p, '\n', e - p);
+        if (n1) {
+          const unsigned char* q = p + 1;
+          while (q < n1 && !isspace(*q)) ++q;
+          const unsigned char* cs = (q < n1) ? q + 1 : n1;
+          const unsigned char* ce = n1;
+          if (ce - cs > 1 && ce[-1] == '\r') --ce;
+          const unsigned char* s = n1 + 1;
+          if (s < e) {
+            unsigned char ch = *s;
+            if (ch == '\n' || ch == '>' || ch == '+' || ch == '@') {
+              st = 2;
+            } else {
+              const unsigned char* n2 = (const unsigned char*)memchr(s, '\n', e - s);
+              if (n2) {
+                const unsigned char* se = n2;
+                if (se - s > 1 && se[-1] == '\r') --se;
+                const unsigned char* t = n2 + 1;
+                if (t < e) {
+                  if (*t != '+') {
+                    st = 2;
+                  } else {
+                    const unsigned char* n3 = (const unsigned char*)memchr(t, '\n', e - t);
+                    const unsigned char* u = n3 ? n3 + 1 : e;
+                    if (n3 && u < e) {
+                      const unsigned char* n4 = (const unsigned char*)memchr(u, '\n', e - u);
+                      if (n4) {
+                        const unsigned char* qe = n4;
+                        if (qe - u > 1 && qe[-1] == '\r') --qe;
+                        if ((size_t)(qe - u) != (size_t)(se - s)) {
+                          st = 2;
+                        } else {
+                          seq.header.assign((const char*)p + 1, q - (p + 1));
+                          seq.comment.assign((const char*)cs, ce > cs ? ce - cs : 0);
+                          seq.seq.assign((const char*)s, se - s);
+                          if (kseq_->skip_qual) seq.quals.clear();
+                          else seq.quals.assign((const char*)u, qe - u);
