+                          file_format_ = SequenceFormat::FORMAT_FASTQ;
+                          slen = (size_t)(se - s);
+                          ks->begin = (int)(n4 + 1 - b);
+                          return true;
+                        }
+                      }
+                    }
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+      if (st == 2) return false;
+      if (!FastFill(ks)) return false;
+    }
+  }
