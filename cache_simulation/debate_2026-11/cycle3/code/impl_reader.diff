+  // Compact the unread bytes to the buffer start and read more (growing the
+  // buffer when the partial record fills it). Same state transitions as
+  // kseq's own refill: is_eof is set when read() returns 0.
+  bool FastFill(kstream_t* ks)
+  {
+    if (ks->is_eof) return false;
+    size_t rem = (size_t)(ks->end - ks->begin);
+    if (ks->begin > 0 && rem > 0) memmove(ks->buf, ks->buf + ks->begin, rem);
+    ks->begin = 0;
+    ks->end = (int)rem;
+    size_t want = ks->cap;
+    if (want < fastbuf_) want = fastbuf_;
+    while (want - rem < want / 4) want *= 2;
+    if (want > ((size_t)1 << 30)) return false;
+    if (want != ks->cap) {
+      unsigned char* nb = (unsigned char*)realloc(ks->buf, want);
+      if (!nb) return false;
+      ks->buf = nb;
+      ks->cap = want;
