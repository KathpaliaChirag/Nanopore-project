+// pre-pass worker: takes chunk tickets from *ticket until none are left (or damage was found) and runs the NullSink parse on each.
+// mm: read through mmap (else pread). *bad is set to 1 when any chunk is not PR_OK (non-tail damage). used by both the
+// OpenMP inline pre-pass and the overlapped std::thread pool, so both make the same decision.
+static inline void prescan_worker(const Plan &plan, uint64_t *ticket, int *bad, bool mm, bool populate, bool verbose) {
+  std::vector<char> pbuf;
+  NullSink ns;
+  for (;;) {
+    uint64_t pt = __atomic_fetch_add(ticket, (uint64_t) 1, __ATOMIC_RELAXED);
+    if (pt >= plan.total) break;
+    if (__atomic_load_n(bad, __ATOMIC_RELAXED)) continue;   // drain remaining tickets quickly
+    size_t pf; uint64_t pk; std::string perr;
+    plan.Locate(pt, pf, pk);
+    int rc = mm ? read_chunk_mm(plan.fds[pf], plan.sizes[pf], pk, plan.B, pbuf, ns, &perr, populate)
+                : read_chunk(plan.fds[pf], plan.sizes[pf], pk, plan.B, pbuf, ns, &perr);
+    if (rc != PR_OK) {
+      __atomic_store_n(bad, 1, __ATOMIC_RELAXED);
+      if (verbose) fprintf(stderr, "K2_PREAD: prescan found damage in chunk %lld: %s\n", (long long) pt, perr.c_str());
+    }
+  }
+}
