+          fmt = s.format = SequenceFormat::FORMAT_FASTQ;
+          if (skipq) s.quals.clear(); else s.quals.assign(r.qual, r.ql);
+        } else {
+          fmt = s.format = SequenceFormat::FORMAT_FASTA;
+        }
+      }
