+  bool LoadPreadTry(k2pread::Plan &plan, uint64_t t, std::string &err) {
+    struct PSink {
+      std::vector<Sequence> &v; size_t n; bool skipq; SequenceFormat fmt; bool last_file; bool tail_failed;
+      void begin() { n = 0; }
+      // damaged tail of the file: replay [p, p+len) through the real kseq_read on a memfd, with stock's per-file rules.
+      // stock (LoadBlock): any kseq_read < 0 moves to the next file if there is one (rest of this file dropped), and in the
+      // last file a -2 just ends the block and the next LoadBlock resumes the stream (resync at the next '@' or '>').
+      void tail(const char *p, size_t len) {
+        int mfd = memfd_create("k2tail", 0);
+        if (mfd < 0) { tail_failed = true; return; }
+        size_t off = 0;
+        while (off < len) {
+          ssize_t w = ::write(mfd, p + off, len - off);
+          if (w <= 0) { tail_failed = true; ::close(mfd); return; }
+          off += (size_t) w;
+        }
+        lseek(mfd, 0, SEEK_SET);
+        kseq_t *ks = kseq_init(mfd);   // copies k2_skip_qual() into ks->skip_qual, same as the stock reader
+        for (;;) {
+          int rc = kseq_read(ks);
+          if (rc >= 0) {
+            if (n == v.size()) v.resize(n + 1);
+            Sequence &s = v[n++];
+            s.header.assign(ks->name.s, ks->name.l);
+            s.comment.assign(ks->comment.s, ks->comment.l);
+            s.seq.assign(ks->seq.s, ks->seq.l);
+            if (ks->qual.l > 0 || ks->qual_len > 0) {
+              fmt = s.format = SequenceFormat::FORMAT_FASTQ;
+              if (ks->qual.l > 0 && ! skipq) s.quals.assign(ks->qual.s, ks->qual.l); else s.quals.clear();
+            } else {
+              fmt = s.format = SequenceFormat::FORMAT_FASTA;
+            }
+          }
+          else if (rc == -1 || ! last_file) break;
+        }
+        kseq_destroy(ks);
+        ::close(mfd);
+      }
+      void add(const k2pread::Rec &r) {
+        if (n == v.size()) v.resize(n + 1);
