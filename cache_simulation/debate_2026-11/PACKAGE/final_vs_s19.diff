+static inline void AppendU64(std::string &o, uint64_t v) {
+  // hand itoa (to_chars needs c++17, the build is c++11)
+  char buf[24];
+  char *p = buf + sizeof(buf);
+  do { *--p = (char) ('0' + (v % 10)); v /= 10; } while (v);
+  o.append(p, buf + sizeof(buf) - p);
+}
