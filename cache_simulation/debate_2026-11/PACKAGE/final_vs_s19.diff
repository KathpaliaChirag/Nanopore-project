+    if (rc == k2pread::PR_OK && sink.tail_failed) { rc = k2pread::PR_BAD; err = "memfd_create or write failed for the damaged tail"; }
+    if (rc != k2pread::PR_OK) { size_ = 0; curr_ = 0; return false; }
+    size_ = sink.n;
+    curr_ = 0;
+    if (size_ > 0) file_format_ = sink.fmt;
+    return true;
+  }
+  void LoadPread(k2pread::Plan &plan, uint64_t t) {
+    std::string err;
+    if (! LoadPreadTry(plan, t, err)) {
