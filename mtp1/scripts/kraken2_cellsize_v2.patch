+// 16-bit cell: identical layout to CompactHashCell but backed by a 16-bit word
+// (e.g. value_bits=6 -> key_bits=10). Same access pattern; only the width differs.
+struct CompactHashCell16 {
+  inline hkey_t hashed_key(size_t value_bits) {
+    return (hkey_t) (data >> value_bits);
+  }
+
+  inline hvalue_t value(size_t value_bits) {
+    return (hvalue_t) (data & ((1 << value_bits) - 1));
+  }
+
+  void populate(hkey_t compacted_key, hvalue_t val, size_t key_bits, size_t value_bits) {
+    if (key_bits + value_bits != 16)
+      errx(EX_SOFTWARE, "key len of %u and value len of %u don't sum to 16",
+           (unsigned int) key_bits, (unsigned int) value_bits);
+    if (! key_bits || ! value_bits)
+      errx(EX_SOFTWARE, "key len and value len must be nonzero");
+    uint64_t max_value = (1llu << value_bits) - 1;
+    if (max_value < val)
+      errx(EX_SOFTWARE, "value len of %u too small for value of %llu",
+           (unsigned int) value_bits, (unsigned long long int) val);
+    data = (uint16_t) ((compacted_key << value_bits) | val);
+  }
+
+  uint16_t data;
+};
+
+// 24-bit cell: packed to exactly 3 bytes. Stored explicitly little-endian, and
+// the only code that ever touches the bytes is these accessors, so unaligned
+// mmap access on x86 is safe. value_bits=6 -> key_bits=18.
+struct CompactHashCell24 {
+  inline hkey_t hashed_key(size_t value_bits) {
+    uint32_t d = (uint32_t) b[0] | ((uint32_t) b[1] << 8) | ((uint32_t) b[2] << 16);
+    return (hkey_t) (d >> value_bits);
+  }
+
+  inline hvalue_t value(size_t value_bits) {
+    uint32_t d = (uint32_t) b[0] | ((uint32_t) b[1] << 8) | ((uint32_t) b[2] << 16);
+    return (hvalue_t) (d & ((1 << value_bits) - 1));
+  }
+
+  void populate(hkey_t compacted_key, hvalue_t val, size_t key_bits, size_t value_bits) {
+    if (key_bits + value_bits != 24)
+      errx(EX_SOFTWARE, "key len of %u and value len of %u don't sum to 24",
+           (unsigned int) key_bits, (unsigned int) value_bits);
+    if (! key_bits || ! value_bits)
+      errx(EX_SOFTWARE, "key len and value len must be nonzero");
+    uint64_t max_value = (1llu << value_bits) - 1;
+    if (max_value < val)
+      errx(EX_SOFTWARE, "value len of %u too small for value of %llu",
+           (unsigned int) value_bits, (unsigned long long int) val);
+    uint32_t d = (uint32_t) ((compacted_key << value_bits) | val);
+    b[0] = (uint8_t) (d & 0xff);
+    b[1] = (uint8_t) ((d >> 8) & 0xff);
+    b[2] = (uint8_t) ((d >> 16) & 0xff);
+  }
+
+  uint8_t b[3];
+} __attribute__((packed));
+
+// 20-bit cell: same 3-byte little-endian storage as CompactHashCell24, but only
+// the low 20 bits are used (key_bits + value_bits = 20; top 4 physical bits stay
+// zero). Fewer fingerprint bits than 24-bit -> more collisions, filling the FP
+// curve between 16- and 24-bit. File size equals the 24-bit DB; the header's
+// key_bits+value_bits (=20) is what distinguishes it. value_bits=6 -> key_bits=14.
