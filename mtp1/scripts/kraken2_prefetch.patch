+// ---- batched lookup with software prefetch (-B) ----------------------------
+// The stock loop resolves one minimizer at a time, so every DRAM access waits
+// for the previous one: measured memory-level parallelism is 1.24 of the ~12
+// the core can sustain, leaving ~187 of 868 cycles per lookup exposed to
+// latency. Batching does not avoid a single memory access -- it overlaps them.
+// Pass 1 hashes B minimizers and issues a prefetch for each; pass 2 resolves
+// them in the original order, by which time the lines are in flight or arrived.
+// -B 1 restores the stock one-at-a-time path exactly.
+static int la_batch = 1;
+struct PfSlot {
+  uint64_t min;     // the minimizer
+  uint64_t hc;      // MurmurHash3(min), computed once in pass 1
+  bool     amb;     // scanner.is_ambiguous() AT THE TIME THIS WAS SCANNED --
+                    // scanner state moves on during pass 1, so it is captured
+};
+static const int PF_MAX = 64;
